{
  "name": "digipoke",
  "version": "1.0.0",
  "private": true,
  "description": "DigiPoke \u2014 a local-first creature-collecting battler PWA with optional end-to-end encrypted sync.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "node tools/dev-server.js",
    "server": "node server/src/server.js",
    "start": "node tools/start-all.js",
    "test": "node --test tests/",
    "test:watch": "node --test --watch tests/",
    "lint": "node tools/lint.js",
    "build:single": "node tools/build-single.mjs",
    "verify:single": "node tools/verify-single.mjs",
    "art": "node tools/gallery.mjs",
    "tunnel": "ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 80:localhost:8080 nokey@localhost.run",
    "publish:github": "node tools/publish-github.mjs",
    "banner": "node tools/banner.mjs",
    "deploy": "node tools/deploy-pages.mjs",
    "playtest": "node tools/playtest.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1"
  },
  "keywords": [
    "pwa",
    "local-first",
    "game",
    "offline",
    "indexeddb"
  ]
}
